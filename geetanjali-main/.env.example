# PostgreSQL Database Connection URL (Asyncpg)
PG_DATABASE_URL=postgresql+asyncpg://geetanjali_user:SecurePassword123!@postgres:5432/geetanjali_db

# PostgreSQL Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT & Authentication
JWT_SECRET=production_jwt_secret_change_me_in_prod_9876543210

# Application Environment & CORS
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost,https://yourdomain.com

# Server Binding
HOST=0.0.0.0
PORT=8000

# Initial Admin Credentials
OWNER_EMAIL=owner@geetanjalisalon.com
OWNER_PASSWORD=OwnerSecurePass123!
MANAGER_EMAIL=manager@geetanjalisalon.com
MANAGER_PASSWORD=ManagerSecurePass123!

# AWS S3 Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=geetanjali-salon-uploads

# Email SMTP Settings (Optional)
EMAIL_USERNAME=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Automatic Backups Directory
BACKUP_DIR=/var/backups/geetanjali
